NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# MySQL / MariaDB — local dev uses the system MariaDB (see README for setup).
# In production, swap these for Hostinger's remote MySQL credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=trojan_app
DB_PASSWORD=change_me_locally
DB_NAME=trojan_leave_tracker
DB_CONNECTION_LIMIT=10

# JWT auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
